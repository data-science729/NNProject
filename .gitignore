# 忽略已废弃的历史课设临时目录（已重构至根目录与 docs/）
AtoB/
AtoC/
NN/

# 忽略 PyTorch 导出的二进制权重模型文件
*.pth
**/best_model_*.pth

# 忽略所有的 zip 压缩包
*.zip

# 忽略大型原始文本数据集与分词文本
dataset/*.txt
dataset/*.clean.txt
# 保留小型停用词表和标准参考词表
!dataset/stopwords.txt
!dataset/cnews.vocab.txt

# 忽略本地生成的词表、词嵌入权重和可视化图片（均可通过脚本一键生成）
dataset/*.json
dataset/*.npy
dataset/*.png

# 忽略训练好的 Word2Vec 模型文件及其权重缓存
dataset/*.model
dataset/word2vec.model*

# 忽略 Python 运行产生的缓存文件夹
__pycache__/
**/__pycache__/
*.pyc

# 忽略 PyCharm 与本地环境配置
.idea/
.vscode/
venv/
.env

# 忽略 LaTeX 编译生成的中间临时文件（保持仓库清爽）
*.aux
*.log
*.out
*.toc
*.synctex.gz
